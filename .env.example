# LendLens configuration
# Set this in your hosting provider's secret manager.
GROQ_API_KEY=your_groq_api_key_here

# Frontend backend address
LENDLENS_API_URL=http://127.0.0.1:8000

LENDLENS_GENERATION_PROVIDER=ollama
LENDLENS_QDRANT_URL=
LENDLENS_QDRANT_API_KEY=

# Hosted API and Streamlit demo only. Use the same secret in both services.
LENDLENS_PUBLIC_DEMO=0
LENDLENS_DEMO_TOKEN=
